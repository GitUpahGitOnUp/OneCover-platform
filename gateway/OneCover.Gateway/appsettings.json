{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "identity-profile": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/me/{**catch-all}"
        }
      },
      "enrollment-plans-read": {
        "ClusterId": "enrollment",
        "AuthorizationPolicy": "anonymous",
        "Order": 0,
        "Match": {
          "Path": "/api/plans/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "enrollment-plans-write": {
        "ClusterId": "enrollment",
        "AuthorizationPolicy": "default",
        "Order": 1,
        "Match": {
          "Path": "/api/plans/{**catch-all}"
        }
      },
      "enrollment-member": {
        "ClusterId": "enrollment",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/enrollments/{**catch-all}"
        }
      },
      "enrollment-admin": {
        "ClusterId": "enrollment",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/admin/enrollments/{**catch-all}"
        }
      },
      "claims-member": {
        "ClusterId": "claims",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/claims/{**catch-all}"
        }
      },
      "claims-admin": {
        "ClusterId": "claims",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/admin/claims/{**catch-all}"
        }
      },
      "disbursements-member": {
        "ClusterId": "disbursements",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/disbursements/{**catch-all}"
        }
      },
      "disbursements-admin": {
        "ClusterId": "disbursements",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/admin/disbursements/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "identity-api": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "enrollment": {
        "Destinations": {
          "enrollment-api": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "claims": {
        "Destinations": {
          "claims-api": {
            "Address": "http://localhost:5003/"
          }
        }
      },
      "disbursements": {
        "Destinations": {
          "disbursements-api": {
            "Address": "http://localhost:5004/"
          }
        }
      }
    }
  }
}
